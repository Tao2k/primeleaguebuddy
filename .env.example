# Postgres connection, e.g. a local database or Neon / Supabase
DATABASE_URL="postgresql://plb:plb@localhost:5432/plb?schema=public"

# Public URL of the app (used for invite links and the Discord redirect)
APP_URL="http://localhost:3000"

# Discord OAuth app: https://discord.com/developers/applications
# Redirect URL to register there: <APP_URL>/login/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Name-only test login for local development; ignored in production
DEV_LOGIN="true"
